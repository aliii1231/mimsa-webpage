---
// src/pages/index.astro
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Search SEO Tags for MIMSA MSU-IIT -->
    <title>MIMSA - Muslim Students Association | MSU-IIT</title>
    <meta name="title" content="MIMSA - Muslim Students Association | MSU-IIT" />
    <meta 
      name="description" 
      content="Official website of the Muslim Students Association at Mindanao State University – Iligan Institute of Technology (MSU-IIT). Mission, vision, committee roles, accomplishments, and membership forms." 
    />
    <meta name="keywords" content="MIMSA, MIMSA MSUIIT, MSU-IIT Muslim Students, Iligan City student organizations" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MIMSA - Muslim Students Association | MSU-IIT" />
    <meta property="og:description" content="Fostering unity, faith, and leadership among Muslim students at MSU-IIT." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'system-ui', 'sans-serif'],
              display: ['Playfair Display', 'Georgia', 'serif'],
            },
            colors: {
              brand: {
                50: '#ecfdf5',
                100: '#d1fae5',
                200: '#a7f3d0',
                300: '#6ee7b7',
                400: '#34d399',
                500: '#10b981',
                600: '#059669',
                700: '#047857',
                800: '#065f46',
                900: '#064e3b',
                950: '#022c22',
              }
            },
            animation: {
              'fade-up': 'fadeUp 0.6s ease-out forwards',
              'fade-in': 'fadeIn 0.8s ease-out forwards',
              'float': 'float 6s ease-in-out infinite',
              'pulse-slow': 'pulse 4s ease-in-out infinite',
            },
            keyframes: {
              fadeUp: {
                '0%': { opacity: '0', transform: 'translateY(30px)' },
                '100%': { opacity: '1', transform: 'translateY(0)' },
              },
              fadeIn: {
                '0%': { opacity: '0' },
                '100%': { opacity: '1' },
              },
              float: {
                '0%, 100%': { transform: 'translateY(0px)' },
                '50%': { transform: 'translateY(-10px)' },
              },
            },
          }
        }
      }
    </script>

    <style>
      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .reveal-delay-1 { transition-delay: 0.1s; }
      .reveal-delay-2 { transition-delay: 0.2s; }
      .reveal-delay-3 { transition-delay: 0.3s; }
      .reveal-delay-4 { transition-delay: 0.4s; }
      .reveal-delay-5 { transition-delay: 0.5s; }

      .geo-pattern {
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      }

      .card-glow {
        transition: all 0.3s ease;
      }
      .card-glow:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -12px rgba(5, 150, 105, 0.15);
      }

      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: #059669;
        border-radius: 1px;
        transition: width 0.3s ease;
      }
      .nav-link:hover::after {
        width: 100%;
      }

      .mobile-menu {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mobile-menu.open {
        max-height: 400px;
      }
    </style>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased font-sans">

    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200/60">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="h-16 flex items-center justify-between">
          <a href="#" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 bg-gradient-to-br from-brand-600 to-brand-800 rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
              <span class="text-white font-black text-sm">M</span>
            </div>
            <span class="font-extrabold text-lg text-slate-900 tracking-tight">MIMSA</span>
          </a>

          <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600">
            <a href="#about" class="nav-link hover:text-brand-700 transition">About</a>
            <a href="#committees" class="nav-link hover:text-brand-700 transition">Committees</a>
            <a href="#accomplishments" class="nav-link hover:text-brand-700 transition">Accomplishments</a>
            <a href="#join" class="nav-link hover:text-brand-700 transition">Get Involved</a>
          </div>

          <div class="flex items-center gap-3">
            <a 
              href="https://forms.gle/UwiLjSdqdK9n3N547" 
              target="_blank" 
              rel="noopener noreferrer"
              class="hidden sm:inline-flex text-xs font-semibold px-4 py-2 rounded-lg text-brand-800 bg-brand-50 hover:bg-brand-100 transition border border-brand-200/80"
            >
              Volunteer ↗
            </a>
            <a 
              href="https://forms.gle/DWeXymRk2YDCY4PW9" 
              target="_blank" 
              rel="noopener noreferrer"
              class="bg-brand-700 text-white text-xs sm:text-sm px-4 py-2 rounded-lg font-semibold hover:bg-brand-800 transition shadow-sm hover:shadow-md"
            >
              Join MIMSA ↗
            </a>

            <button id="menuBtn" class="md:hidden p-2 rounded-lg hover:bg-slate-100 transition" aria-label="Toggle menu">
              <svg id="menuIcon" class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
              <svg id="closeIcon" class="w-5 h-5 text-slate-700 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="mobileMenu" class="mobile-menu md:hidden border-t border-slate-100">
          <div class="py-4 space-y-1">
            <a href="#about" class="block px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-lg transition">About</a>
            <a href="#committees" class="block px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-lg transition">Committees</a>
            <a href="#accomplishments" class="block px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-lg transition">Accomplishments</a>
            <a href="#join" class="block px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700 rounded-lg transition">Get Involved</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-800 to-slate-900 geo-pattern"></div>
      <div class="absolute top-20 -left-20 w-72 h-72 bg-brand-400/20 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-10 -right-20 w-96 h-96 bg-brand-300/10 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/5 rounded-full blur-3xl"></div>

      <div class="relative py-24 sm:py-32 lg:py-40 px-4 max-w-5xl mx-auto text-center">
        <div class="animate-fade-in">
          <span class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-bold text-brand-200 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/10">
            <span class="w-2 h-2 bg-brand-400 rounded-full animate-pulse-slow"></span>
            Mindanao State University – Iligan Institute of Technology
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-black text-white mt-8 tracking-tight leading-tight animate-fade-up">
          Muslim Students<br>
          Association <span class="text-brand-300">(MIMSA)</span>
        </h1>

        <p class="text-brand-100/80 text-lg sm:text-xl mt-6 max-w-2xl mx-auto leading-relaxed animate-fade-up" style="animation-delay: 0.2s;">
          Dedicated to serving the spiritual, academic, and social welfare of Muslim students across the MSU-IIT campus.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4 animate-fade-up" style="animation-delay: 0.4s;">
          <a 
            href="https://forms.gle/DWeXymRk2YDCY4PW9" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group bg-white hover:bg-brand-50 text-brand-800 font-bold px-7 py-3.5 rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center gap-2"
          >
            Register as Member 
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a 
            href="https://forms.gle/UwiLjSdqdK9n3N547" 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-semibold px-7 py-3.5 rounded-xl border border-white/20 transition-all"
          >
            Sign Up as Volunteer ↗
          </a>
        </div>

        <div class="mt-16 grid grid-cols-3 max-w-md mx-auto gap-4 animate-fade-up" style="animation-delay: 0.6s;">
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">6</div>
            <div class="text-xs text-brand-200/70 mt-1 font-medium">Committees</div>
          </div>
          <div class="text-center border-x border-white/10">
            <div class="text-2xl sm:text-3xl font-black text-white">3+</div>
            <div class="text-xs text-brand-200/70 mt-1 font-medium">Key Programs</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">1</div>
            <div class="text-xs text-brand-200/70 mt-1 font-medium">United Ummah</div>
          </div>
        </div>
      </div>

      <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
          <path d="M0 40L60 36C120 32 240 24 360 28C480 32 600 48 720 52C840 56 960 48 1080 40C1200 32 1320 24 1380 20L1440 16V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0V40Z" fill="#f8fafc"/>
        </svg>
      </div>
    </header>

    <!-- Mission & Vision Section -->
    <section id="about" class="py-20 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1 rounded-full">Who We Are</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mt-4">About MIMSA</h2>
          <p class="text-slate-500 mt-3 text-lg">Guiding values and commitments at MSU-IIT.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="reveal reveal-delay-1 group card-glow p-8 sm:p-10 rounded-2xl bg-white border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-400 to-brand-600"></div>
            <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Our Vision</h3>
            <p class="text-slate-600 leading-relaxed">
              A united, proactive, and values-driven Muslim student community at MSU-IIT that excels in academic pursuits, upholds Islamic morals, and contributes constructively to society.
            </p>
          </div>

          <div class="reveal reveal-delay-2 group card-glow p-8 sm:p-10 rounded-2xl bg-white border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-600 to-brand-400"></div>
            <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Our Mission</h3>
            <p class="text-slate-600 leading-relaxed">
              To foster brotherhood and sisterhood, provide platforms for spiritual and leadership development, advocate for Muslim student welfare on campus, and facilitate community service initiatives.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Committee Roles Section -->
    <section id="committees" class="py-20 sm:py-24 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1 rounded-full">Our Structure</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mt-4">Committee Roles</h2>
          <p class="text-slate-500 mt-3 text-lg">The teams that drive MIMSA's projects throughout the academic year.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="reveal reveal-delay-1 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-amber-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">📖</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Da'wah Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Organizes halaqah study circles, Islamic awareness seminars, and coordinates campus prayer room logistics.
            </p>
          </div>

          <div class="reveal reveal-delay-2 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-rose-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">🤝</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Humanitarian Outreach Program Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Leads campus outreach, Ramadan iftar distributions, disaster relief drives, and volunteer initiatives.
            </p>
          </div>

          <div class="reveal reveal-delay-3 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">🎓</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Salaam/Peace Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Facilitates peer tutorials, review sessions, survival guides, and mentoring for incoming freshmen.
            </p>
          </div>

          <div class="reveal reveal-delay-1 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-violet-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">📋</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Secretariat Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Manages official documentation, directory records, meeting minutes, and accreditation requirements.
            </p>
          </div>

          <div class="reveal reveal-delay-2 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">💰</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">IGP Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Oversees organization funds, and financial liquidation reports.
            </p>
          </div>

          <div class="reveal reveal-delay-3 card-glow group p-7 bg-slate-50 rounded-2xl border border-slate-200/80 hover:bg-white hover:border-brand-200 transition-all">
            <div class="w-11 h-11 bg-cyan-100 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <span class="text-xl">📱</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">TRI-MED Committee</h3>
            <p class="text-sm text-slate-500 mt-2 leading-relaxed">
              Produces digital publication materials, manages official social media channels, and archives past initiatives.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Accomplishments Section -->
    <section id="accomplishments" class="py-20 sm:py-24 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-brand-100/30 rounded-full blur-3xl -translate-y-1/2"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-brand-100/20 rounded-full blur-3xl translate-y-1/2"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 relative">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-50 px-3 py-1 rounded-full">Impact & Service</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-slate-900 mt-4">Organization Accomplishments</h2>
          <p class="text-slate-500 mt-3 text-lg">Milestones and initiatives delivered for the MSU-IIT community.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
          <div class="reveal reveal-delay-1 card-glow bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm text-center relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-amber-400 to-orange-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-16 h-16 bg-amber-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform">
              <span class="text-3xl">🌙</span>
            </div>
            <span class="text-sm font-bold uppercase tracking-wider text-amber-600">Annual</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Ramadan Iftar Feeding</h3>
            <p class="text-sm text-slate-500 mt-3 leading-relaxed">
              Provided daily iftar meals and dates for fasting students and campus workers throughout the holy month.
            </p>
          </div>

          <div class="reveal reveal-delay-2 card-glow bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm text-center relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-brand-400 to-brand-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-16 h-16 bg-brand-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform">
              <span class="text-3xl">🕌</span>
            </div>
            <span class="text-sm font-bold uppercase tracking-wider text-brand-600">Campus</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Musalla Upkeep & Care</h3>
            <p class="text-sm text-slate-500 mt-3 leading-relaxed">
              Regular maintenance, cleaning drives, and prayer supply upkeep for campus musalla and designated prayer rooms.
            </p>
          </div>

          <div class="reveal reveal-delay-3 card-glow bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm text-center relative overflow-hidden group">
            <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-blue-400 to-indigo-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform">
              <span class="text-3xl">🎒</span>
            </div>
            <span class="text-sm font-bold uppercase tracking-wider text-blue-600">Support</span>
            <h3 class="text-xl font-bold text-slate-900 mt-2">Freshmen Orientation</h3>
            <p class="text-sm text-slate-500 mt-3 leading-relaxed">
              Welcomed incoming Muslim students with campus survival guides, peer mentors, and community briefings.
            </p>
          </div>
        </div>
